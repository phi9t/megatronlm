+    def test_hf_to_megatron_uses_orig_param_shape_for_fsdp_dtensor(
+        self, mock_distributed_env, transformer_config, monkeypatch
+    ):
+        from megatron.bridge.models.conversion import param_mapping as param_mapping_module
+
+        _, mock_dist = mock_distributed_env(tp_size=2, tp_rank=0)
+        mapping = ColumnParallelMapping("embedding.word_embeddings.weight", "model.embed_tokens.weight")
+        megatron_module = MockModule(transformer_config, weight_shape=(1, 1))
+        hf_weight = torch.randn(32, 16)
+
+        class FakeDTensor:
+            def __init__(self):
+                self.shape = torch.Size((32, 16))
+                self.orig_param = torch.empty(16, 16)
+                self.dtype = torch.float32
+                self.device = torch.device("cpu")
+
+        target_param = FakeDTensor()
+        monkeypatch.setattr(param_mapping_module, "DTensor", FakeDTensor)
+        monkeypatch.setattr(
+            param_mapping_module,
+            "get_module_and_param_from_name",
+            lambda module, name: (module, target_param),
+        )
+
+        def mock_scatter(output, scatter_list, src, group):
+            assert scatter_list[0].shape == torch.Size((16, 16))
+            output.copy_(scatter_list[0])
+
+        mock_dist.scatter.side_effect = mock_scatter
+        megatron_weight = mapping.hf_to_megatron(hf_weight, megatron_module)
+
+        assert megatron_weight.shape == torch.Size((16, 16))
+
 
